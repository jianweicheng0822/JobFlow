# Database
# Local runs only: the MySQL container from docker compose is published on 3307.
# Docker ignores this (the backend container talks to mysql:3306).
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long

# Mail (Gmail SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# OAuth2 - optional. Each provider is on when both its id and secret are set;
# leave both empty to turn it off. Google also enables Gmail import.

# OAuth2 - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth2 - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sample data: creates demo@jobflow.com / demo123 on startup (local demos only)
SEED_DEMO_DATA=false
